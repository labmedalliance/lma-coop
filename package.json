{
  "name": "lma-coop",
  "version": "1.0.0",
  "description": "Self-hosted collaborative editor for scientific publications",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "adduser": "node --disable-warning=ExperimentalWarning scripts/adduser.js",
    "test": "node --test test/*.test.js"
  },
