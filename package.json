  "license": "AGPL-3.0-or-later",
  "homepage": "https://labmedalliance.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/labmedalliance/lma-coop.git"
  },
  "dependencies": {
    "@handlewithcare/prosemirror-suggest-changes": "0.1.8",
    "@hocuspocus/common": "4.8.0",
    "@hocuspocus/extension-database": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-blockquote": "3.33.0",
    "@tiptap/extension-document": "3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-list": "3.33.0",
    "@tiptap/extension-subscript": "3.33.0",
    "@tiptap/extension-superscript": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-text-align": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/y-tiptap": "3.2.0",
    "express": "5.3.0",
    "ws": "8.22.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.8.0",
    "@tabler/core": "1.7.3",
    "@tabler/icons-webfont": "3.50.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-collaboration-caret": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "docx": "9.15.2",
